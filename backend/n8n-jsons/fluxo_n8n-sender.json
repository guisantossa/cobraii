{
  "name": "Cobraii - Sender",
  "nodes": [
    {
      "parameters": { "functionCode": "return [{ json: $json }];" },
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [ 200, 200 ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            { "value1": "={{$json.channels_order[0]}}", "operation": "equal", "value2": "whatsapp" }
          ]
        }
      },
      "id": "if-whats",
      "name": "If WhatsApp First",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 420, 200 ]
    },


    {
      "parameters": {
        "url": "https://SEU_PROVIDER_WHATS/send",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "retryOnFail": true, "maxRetries": 3, "timeout": 30000 },
        "bodyParametersJson": "={\"to\": $json.destinatario.telefone, \"text\": $json.rendered_message}"
      },
      "id": "send-whats",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 640, 120 ]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/v1/internal/occurrences/{{$json.ocorrencia_id}}/result",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "{{$env.INTERNAL_API_KEY}}" } },
        "bodyParametersJson": "={\"final\": true, \"status\": \"entregue\", \"canal_usado\": \"whatsapp\", \"tentativa\": 1, \"codigo\": null, \"mensagem\": \"ok\", \"protocolo_externo\": $json.protocolo || null}"
      },
      "id": "result-ok",
      "name": "Result OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 900, 120 ]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/v1/internal/occurrences/{{$json.ocorrencia_id}}/result",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "{{$env.INTERNAL_API_KEY}}" } },
        "bodyParametersJson": "={\"final\": false, \"status\": \"falhou\", \"canal_usado\": \"whatsapp\", \"tentativa\": 1, \"codigo\": \"WHATS_PROVIDER_DOWN\", \"mensagem\": \"falha whats\"}"
      },
      "id": "result-fail-partial",
      "name": "Result Fail (partial)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 900, 260 ]
    },


    {
      "parameters": {
        "fromEmail": "no-reply@seu-dominio.com",
        "toEmail": "={{$json.destinatario.email}}",
        "subject": "Lembrete",
        "text": "={{$json.rendered_message}}"
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [ 1120, 260 ]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/v1/internal/occurrences/{{$json.ocorrencia_id}}/result",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "{{$env.INTERNAL_API_KEY}}" } },
        "bodyParametersJson": "={\"final\": true, \"status\": \"entregue\", \"canal_usado\": \"email\", \"tentativa\": 1, \"codigo\": null, \"mensagem\": \"ok\"}"
      },
      "id": "result-email-ok",
      "name": "Result Email OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1360, 260 ]
    }
  ],
  "connections": {
    "Start": { "main": [ [ { "node": "If WhatsApp First", "type": "main", "index": 0 } ] ] },
    "If WhatsApp First": {
      "main": [
        [ { "node": "Send WhatsApp", "type": "main", "index": 0 } ],
        [ { "node": "Send Email", "type": "main", "index": 0 } ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [ { "node": "Result OK", "type": "main", "index": 0 } ],
        [ { "node": "Result Fail (partial)", "type": "main", "index": 1 } ]
      ]
    },
    "Result Fail (partial)": { "main": [ [ { "node": "Send Email", "type": "main", "index": 0 } ] ] },
    "Send Email": { "main": [ [ { "node": "Result Email OK", "type": "main", "index": 0 } ] ] }
  }
}
