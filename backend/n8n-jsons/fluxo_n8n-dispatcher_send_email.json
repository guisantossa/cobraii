{
  "name": "Cobraii - Sender Email",
  "nodes": [
    {
      "parameters": {
        "functionCode": "const email = $json.destinatario?.email || '';\nif (!email) {\n  return [{ json: { ...$json, _noEmail: true } }];\n}\nreturn [{ json: { ...$json, _noEmail: false } }];"
      },
      "id": "fn_check",
      "name": "Check Email",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [ 260, 200 ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            { "value1": "={{$json._noEmail ? '1' : '0'}}", "operation": "equal", "value2": "1" }
          ]
        }
      },
      "id": "if_no_email",
      "name": "If No Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 480, 200 ]
    },
    {
      "parameters": {
        "fromEmail": "no-reply@seu-dominio.com",
        "toEmail": "={{$json.destinatario.email}}",
        "subject": "Lembrete",
        "text": "={{$json.rendered_message}}",
        "options": { "allowUnauthorizedCerts": true }
      },
      "id": "email_send",
      "name": "Email Send",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [ 700, 120 ],
      "credentials": { "smtp": { "id": "", "name": "" } }
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "={{$env.INTERNAL_API_KEY}}" }, "timeout": 30000 },
        "bodyParametersJson": "={\n  \"final\": true,\n  \"status\": \"entregue\",\n  \"canal_usado\": \"email\",\n  \"tentativa\": 1,\n  \"codigo\": null,\n  \"mensagem\": \"ok\"\n}"
      },
      "id": "result_ok",
      "name": "Result OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [ 960, 120 ]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "={{$env.INTERNAL_API_KEY}}" }, "timeout": 30000 },
        "bodyParametersJson": "={\n  \"final\": true,\n  \"status\": \"falhou\",\n  \"canal_usado\": \"email\",\n  \"tentativa\": 1,\n  \"codigo\": \"EMAIL_NO_ADDRESS\",\n  \"mensagem\": \"destinatario sem email\"\n}"
      },
      "id": "result_no_email",
      "name": "Result → No Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [ 700, 300 ]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "={{$env.INTERNAL_API_KEY}}" }, "timeout": 30000 },
        "bodyParametersJson": "={\n  \"final\": false,\n  \"status\": \"falhou\",\n  \"canal_usado\": \"email\",\n  \"tentativa\": 1,\n  \"codigo\": \"EMAIL_PROVIDER_ERROR\",\n  \"mensagem\": \"falha no envio\"\n}"
      },
      "id": "result_fail_partial",
      "name": "Result → Fail (partial)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [ 960, 260 ]
    },
    {
      "parameters": {},
      "id": "noop",
      "name": "On Error (Continue)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [ 1200, 260 ]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": { "headers": { "X-API-Key": "={{$env.INTERNAL_API_KEY}}" }, "timeout": 30000 },
        "bodyParametersJson": "={\n  \"final\": true,\n  \"status\": \"falhou\",\n  \"canal_usado\": \"email\",\n  \"tentativa\": 3,\n  \"codigo\": \"EMAIL_PROVIDER_DOWN\",\n  \"mensagem\": \"falhou apos retries\"\n}"
      },
      "id": "result_fail_final",
      "name": "Result → Fail (final)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [ 1420, 260 ]
    }
  ],
  "connections": {
    "Check Email": {
      "main": [
        [ { "node": "If No Email", "type": "main", "index": 0 } ]
      ]
    },
    "If No Email": {
      "main": [
        [ { "node": "Email Send", "type": "main", "index": 0 } ],
        [ { "node": "Result → No Email", "type": "main", "index": 0 } ]
      ]
    },
    "Email Send": {
      "main": [
        [ { "node": "Result OK", "type": "main", "index": 0 } ]
      ],
      "error": [
        [ { "node": "Result → Fail (partial)", "type": "main", "index": 0 } ]
      ]
    },
    "Result → Fail (partial)": {
      "main": [
        [ { "node": "On Error (Continue)", "type": "main", "index": 0 } ]
      ]
    },
    "On Error (Continue)": {
      "main": [
        [ { "node": "Result → Fail (final)", "type": "main", "index": 0 } ]
      ]
    }
  }
}
