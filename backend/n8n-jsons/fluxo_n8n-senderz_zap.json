{
  "name": "Cobraii - Sender Whats (Evolution)",
  "nodes": [
    {
      "parameters": {
        "functionCode": "const tel = $json.destinatario?.telefone || '';\n// normaliza: só dígitos\nconst digits = (tel || '').replace(/\\D/g, '');\nif (!digits) {\n  // sem telefone, falha final\n  return [{ json: { ...$json, _noPhone: true, _digits: null } }];\n}\nreturn [{ json: { ...$json, _noPhone: false, _digits: digits } }];"
      },
      "id": "fn_normalize",
      "name": "Normalize Phone",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [260, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{$json._noPhone ? '1' : '0'}}",
              "operation": "equal",
              "value2": "1"
            }
          ]
        }
      },
      "id": "if_no_phone",
      "name": "If No Phone",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 200]
    },
    {
      "parameters": {
        "url": "={{$env.EVOLUTION_BASE_URL}}/message/text",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": {
          "retryOnFail": true,
          "maxRetries": 3,
          "allowUnauthorizedCerts": true,
          "timeout": 30000
        },
        "bodyParametersJson": "={\n  \"session\": $env.EVOLUTION_SESSION,\n  \"number\": $json._digits,\n  \"text\": $json.rendered_message\n}"
      },
      "id": "http_send_whats",
      "name": "HTTP → Evolution Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [700, 120]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": {
          "headers": {
            "X-API-Key": "={{$env.INTERNAL_API_KEY}}"
          },
          "timeout": 30000
        },
        "bodyParametersJson": "={\n  \"final\": true,\n  \"status\": \"entregue\",\n  \"canal_usado\": \"whatsapp\",\n  \"tentativa\": 1,\n  \"codigo\": null,\n  \"mensagem\": \"ok\",\n  \"protocolo_externo\": $json.protocolo || null\n}"
      },
      "id": "result_ok",
      "name": "Result OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [960, 120]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": {
          "headers": {
            "X-API-Key": "={{$env.INTERNAL_API_KEY}}"
          },
          "timeout": 30000
        },
        "bodyParametersJson": "={\n  \"final\": true,\n  \"status\": \"falhou\",\n  \"canal_usado\": \"whatsapp\",\n  \"tentativa\": 1,\n  \"codigo\": \"WHATS_NO_PHONE\",\n  \"mensagem\": \"destinatario sem telefone\"\n}"
      },
      "id": "result_no_phone",
      "name": "Result → No Phone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [700, 300]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": {
          "headers": {
            "X-API-Key": "={{$env.INTERNAL_API_KEY}}"
          },
          "timeout": 30000
        },
        "bodyParametersJson": "={\n  \"final\": false,\n  \"status\": \"falhou\",\n  \"canal_usado\": \"whatsapp\",\n  \"tentativa\": 1,\n  \"codigo\": \"WHATS_PROVIDER_ERROR\",\n  \"mensagem\": \"falha no provider\"\n}"
      },
      "id": "result_fail_partial",
      "name": "Result → Fail (partial)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [960, 260]
    },
    {
      "parameters": {},
      "id": "on_error",
      "name": "On Error (Continue)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1200, 260]
    },
    {
      "parameters": {
        "url": "={{\"http://localhost:8000/api/v1/internal/occurrences/\" + $json.ocorrencia_id + \"/result\"}}",
        "method": "POST",
        "sendBody": true,
        "jsonParameters": true,
        "options": {
          "headers": {
            "X-API-Key": "={{$env.INTERNAL_API_KEY}}"
          },
          "timeout": 30000
        },
        "bodyParametersJson": "={\n  \"final\": true,\n  \"status\": \"falhou\",\n  \"canal_usado\": \"whatsapp\",\n  \"tentativa\": 3,\n  \"codigo\": \"WHATS_PROVIDER_DOWN\",\n  \"mensagem\": \"falhou apos retries\"\n}"
      },
      "id": "result_fail_final",
      "name": "Result → Fail (final)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [1420, 260]
    }
  ],
  "connections": {
    "Normalize Phone": {
      "main": [
        [
          {
            "node": "If No Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If No Phone": {
      "main": [
        [
          {
            "node": "HTTP → Evolution Send",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Result → No Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP → Evolution Send": {
      "main": [
        [
          {
            "node": "Result OK",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "error": [
        [
          {
            "node": "Result → Fail (partial)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Result → Fail (partial)": {
      "main": [
        [
          {
            "node": "On Error (Continue)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On Error (Continue)": {
      "main": [
        [
          {
